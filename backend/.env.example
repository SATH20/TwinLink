# ================================================
# TwinLink Backend — Environment Configuration
# ================================================
# Copy this file to .env and fill in your values

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ---- Clerk Authentication ----
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ---- Firebase ----
# Path to Firebase service account JSON file (relative to backend root)
FIREBASE_SERVICE_ACCOUNT_PATH=./private.json
# Or use individual environment variables:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Redis (for BullMQ) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- FastAPI AI Service ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# ---- Rate Limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ---- Scheduler ----
# How often (in minutes) the scheduler checks for twins to wake
SCHEDULER_INTERVAL_MINUTES=5
# Jitter (in minutes) added to nextWake to prevent thundering herd
SCHEDULER_JITTER_MINUTES=2

# ---- Logging ----
LOG_LEVEL=debug
